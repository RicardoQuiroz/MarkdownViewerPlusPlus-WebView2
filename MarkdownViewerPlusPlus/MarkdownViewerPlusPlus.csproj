<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>com.insanitydesign.MarkdownViewerPlusPlus</RootNamespace>
    <AssemblyName>MarkdownViewerPlusPlus</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <Platforms>x64;x86</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <!-- Bitmaps in .resx files need pre-serialized resources when built with the .NET SDK -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <NoWarn>$(NoWarn);CS1591;CS0618;CA1416;NU1701</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Where the finished plugin folder is assembled -->
    <PluginOutputDir>$(MSBuildProjectDirectory)\..\dist\$(Platform)\MarkdownViewerPlusPlus\</PluginOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.40.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <!-- Only used at build time to disassemble the managed DLL and add the native exports Notepad++ needs -->
    <PackageReference Include="runtime.win-x64.Microsoft.NETCore.ILDAsm" Version="8.0.0" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\MarkdownViewerHTML.css" />
    <EmbeddedResource Include="Resources\viewer.html" LogicalName="viewer.html" />
    <EmbeddedResource Include="Resources\viewer.css" LogicalName="viewer.css" />
    <EmbeddedResource Include="Resources\viewer.js" LogicalName="viewer.js" />
  </ItemGroup>

  <!--
    Notepad++ loads plugins with LoadLibrary and calls plain C exports (isUnicode, setInfo, getName, ...).
    A C# assembly has no such exports, so after the build we round-trip it through IL:
    ildasm -> add ".export" directives -> ilasm. See tools\DllExport.ps1.
  -->
  <Target Name="NppDllExport" AfterTargets="Build">
    <PropertyGroup>
      <IlDasmExe>$(Pkgruntime_win-x64_Microsoft_NETCore_ILDAsm)\runtimes\win-x64\native\ildasm.exe</IlDasmExe>
      <IlAsmExe Condition="'$(Platform)' == 'x64'">$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\ilasm.exe</IlAsmExe>
      <IlAsmExe Condition="'$(Platform)' == 'x86'">$(WINDIR)\Microsoft.NET\Framework\v4.0.30319\ilasm.exe</IlAsmExe>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\DllExport.ps1&quot; -Assembly &quot;$(TargetPath)&quot; -Platform $(Platform) -IlDasm &quot;$(IlDasmExe)&quot; -IlAsm &quot;$(IlAsmExe)&quot;" />

    <!-- Assemble the plugin folder: plugins\MarkdownViewerPlusPlus\ -->
    <ItemGroup>
      <PluginFiles Include="$(TargetDir)*.dll" Exclude="$(TargetDir)Microsoft.Web.WebView2.Wpf.dll" />
      <PluginLoader Include="$(TargetDir)runtimes\win-$(Platform)\native\WebView2Loader.dll" />
      <PluginDocs Include="$(MSBuildProjectDirectory)\..\LICENSE.md;$(MSBuildProjectDirectory)\..\README.md" />
      <PluginLicenses Include="$(MSBuildProjectDirectory)\..\license\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PluginOutputDir)" />
    <Copy SourceFiles="@(PluginFiles);@(PluginLoader);@(PluginDocs)" DestinationFolder="$(PluginOutputDir)" />
    <Copy SourceFiles="@(PluginLicenses)" DestinationFolder="$(PluginOutputDir)license" />
    <Message Importance="high" Text="Plugin ready: $(PluginOutputDir)" />
  </Target>

</Project>
